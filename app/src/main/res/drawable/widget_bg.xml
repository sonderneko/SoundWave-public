<?xml version="1.0" encoding="utf-8"?>
<!-- Warm-paper widget card: paper fill, one hairline outline, generous radius.
     Colors resolve through values / values-night, so one drawable serves both themes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_paper" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_outline" />
    <corners android:radius="28dp" />
</shape>
