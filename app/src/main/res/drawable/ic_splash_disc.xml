<?xml version="1.0" encoding="utf-8"?>
<!--
  ACCEPT6 启动页图标：与启动器图标前景 ic_launcher_foreground 同源的 VinylDiscMotif 黑胶盘，
  几何按同一母题等比放大（盘半径 31→44，中心 54,54，沟纹比 84/74/64/54/45 沿用），
  让启动页上的盘面比 adaptive 前景层更饱满。盘面渐变 VinylCore #2B302C → VinylEdge #3D433E、
  芯标品牌珊瑚 #E8452F、中心孔 evenOdd 镂空透出启动页纸底，与图标棒的定稿保持同一语言。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 盘面：径向渐变填充，中心孔 evenOdd 镂空 -->
    <path
        android:fillType="evenOdd"
        android:pathData="M10,54 a44,44 0 1,0 88,0 a44,44 0 1,0 -88,0 Z M50.9,54 a3.1,3.1 0 1,0 6.2,0 a3.1,3.1 0 1,0 -6.2,0 Z">
        <gradient
            android:type="radial"
            android:centerX="54"
            android:centerY="54"
            android:gradientRadius="44">
            <item android:offset="0" android:color="#FF2B302C" />
            <item android:offset="0.3" android:color="#FF2B302C" />
            <item android:offset="1" android:color="#FF3D433E" />
        </gradient>
    </path>

    <!-- 盘缘描边：黑 12% -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1F000000"
        android:strokeWidth="1"
        android:pathData="M10,54 a44,44 0 1,0 88,0 a44,44 0 1,0 -88,0 Z" />

    <!-- 沟纹 5 圈：白 9% -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#17FFFFFF"
        android:strokeWidth="0.7"
        android:pathData="M14.7,54 a39.3,39.3 0 1,0 78.6,0 a39.3,39.3 0 1,0 -78.6,0 Z M19.4,54 a34.6,34.6 0 1,0 69.2,0 a34.6,34.6 0 1,0 -69.2,0 Z M24.1,54 a29.9,29.9 0 1,0 59.8,0 a29.9,29.9 0 1,0 -59.8,0 Z M28.7,54 a25.3,25.3 0 1,0 50.6,0 a25.3,25.3 0 1,0 -50.6,0 Z M32.9,54 a21.1,21.1 0 1,0 42.2,0 a21.1,21.1 0 1,0 -42.2,0 Z" />

    <!-- 左上高光弧：白 20%、圆头 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:pathData="M19.2,33.7 A40.3,40.3 0 0 1 40.7,16" />

    <!-- 珊瑚芯标 + 白 25% 细环，中心孔 evenOdd 镂空 -->
    <path
        android:fillType="evenOdd"
        android:fillColor="#FFE8452F"
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="0.7"
        android:pathData="M39.5,54 a14.5,14.5 0 1,0 29,0 a14.5,14.5 0 1,0 -29,0 Z M50.9,54 a3.1,3.1 0 1,0 6.2,0 a3.1,3.1 0 1,0 -6.2,0 Z" />
</vector>
