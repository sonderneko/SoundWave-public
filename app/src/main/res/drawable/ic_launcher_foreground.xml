<?xml version="1.0" encoding="utf-8"?>
<!--
  ACCEPT6 图标换新 · adaptive icon 前景（108dp 画布）。
  设计语言与 DefaultCover 的 VinylDiscMotif 同源：黑胶圆盘 + 同心沟纹 + 珊瑚芯标 + 中心孔。
  几何（中心 54,54）：盘半径 31（关键图形落在中央 66dp 安全区内），沟纹半径比沿用母题
  84/74/64/54/45（/94）缩放，芯标 31/94 缩放 ≈ 10.2，中心孔 2.2（evenOdd 镂空，透出暖纸底）。
  盘面径向渐变沿用母题芯/缘色 VinylCore #2B302C（stop .3）→ VinylEdge #3D433E；芯标用品牌珊瑚
  AccentDeep #E8452F（与通知 setColor 同值）；左上高光弧沿用母题（r86 弧段、白 20%、圆头）。
  本文件即原孤儿前景矢量的处置：原地重绘并由 mipmap-anydpi-v26 的 adaptive-icon 正式引用。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 盘面：径向渐变填充，中心孔 evenOdd 镂空 -->
    <path
        android:fillType="evenOdd"
        android:pathData="M23,54 a31,31 0 1,0 62,0 a31,31 0 1,0 -62,0 Z M51.8,54 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 Z">
        <gradient
            android:type="radial"
            android:centerX="54"
            android:centerY="54"
            android:gradientRadius="31">
            <item android:offset="0" android:color="#FF2B302C" />
            <item android:offset="0.3" android:color="#FF2B302C" />
            <item android:offset="1" android:color="#FF3D433E" />
        </gradient>
    </path>

    <!-- 盘缘描边：黑 12% -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1F000000"
        android:strokeWidth="0.7"
        android:pathData="M23,54 a31,31 0 1,0 62,0 a31,31 0 1,0 -62,0 Z" />

    <!-- 沟纹 5 圈：白 9% -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#17FFFFFF"
        android:strokeWidth="0.5"
        android:pathData="M26.3,54 a27.7,27.7 0 1,0 55.4,0 a27.7,27.7 0 1,0 -55.4,0 Z M29.6,54 a24.4,24.4 0 1,0 48.8,0 a24.4,24.4 0 1,0 -48.8,0 Z M32.9,54 a21.1,21.1 0 1,0 42.2,0 a21.1,21.1 0 1,0 -42.2,0 Z M36.2,54 a17.8,17.8 0 1,0 35.6,0 a17.8,17.8 0 1,0 -35.6,0 Z M39.15,54 a14.85,14.85 0 1,0 29.7,0 a14.85,14.85 0 1,0 -29.7,0 Z" />

    <!-- 左上高光弧：白 20%、圆头（母题 r86 弧段 209.6°→250.7° 缩放） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M29.5,39.7 A28.4,28.4 0 0 1 44.6,27.2" />

    <!-- 珊瑚芯标 + 白 25% 细环，中心孔 evenOdd 镂空 -->
    <path
        android:fillType="evenOdd"
        android:fillColor="#FFE8452F"
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="0.5"
        android:pathData="M43.8,54 a10.2,10.2 0 1,0 20.4,0 a10.2,10.2 0 1,0 -20.4,0 Z M51.8,54 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 Z" />
</vector>
