<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ACCEPT6 启动页收编：旧深蓝窗口底与旧紫 colorPrimary 一并清退——
         窗口底与系统栏跟应用纸面（浅色纸面色值见下，夜间版在 values-night），
         colorPrimary 对齐品牌珊瑚（ThemeTokens.PrimaryCoralDeep 同值）。 -->
    <style name="Theme.SoundWave" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#F4F4F0</item>
        <item name="android:navigationBarColor">#F4F4F0</item>
        <item name="android:windowBackground">#F4F4F0</item>
        <item name="android:colorPrimary">#E8452F</item>
    </style>

    <!-- 启动页（core-splashscreen）：退场后切回 Theme.SoundWave。保持时长由 MainActivity
         的 SplashGate 就绪驱动 + 1.5s 硬顶保险丝控制，本主题不设任何延时。
         ICON-SPLASH-REDO（2026-11-05）：品牌稿参数——底色暖奶油 #F2EADA（F1 的纯纸面
         #F4F4F0 被用户嫌「太白、不好看」；新底与图标暖白渐变 #F8F7F4→#E1DDD6 同族、
         深一阶，退场 200ms 淡出衔接 App 纸面不跳色）；标记 = ic_splash_mark 场景
         （环纹水印 + 选定声纹环标记）；字标 SoundWave（Newsreader SemiBold 渲染图）
         经 values-v31 的 branding image 在 API 31+ 底部呈现，低版本只呈标记。
         BATCH2 反馈 F1：启动页全系统一稿（浅/夜同稿），不再随系统夜间变黑
         （values-night 不再覆盖本样式，理由见 values-night/themes.xml）。 -->
    <style name="Theme.SoundWave.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F2EADA</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.SoundWave</item>
    </style>
</resources>
